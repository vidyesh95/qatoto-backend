{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": ["dist", "node_modules", ".agent", ".agents", "docs", "drizzle"],
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {
    "internalPattern": ["^#src/.*"]
  },
  "sortPackageJson": true,
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.spec.ts"],
      "options": {
        "printWidth": 120
      }
    },
    {
      "files": ["*.md"],
      "options": {
        "tabWidth": 4
      }
    }
  ]
}
