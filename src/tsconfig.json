{
  /* Editor-only config. The TS language server auto-discovers the nearest file
     literally named "tsconfig.json", so every file under src/ — app code AND the
     co-located test files — binds here and resolves #src/* subpath imports via the
     inherited "customConditions": ["development"].

     The root ../tsconfig.json excludes test files (to keep them out of the dist/
     build), which left them in an inferred project where the editor reported
     phantom errors. Unlike the root, this config includes them.

     `exclude` MUST be redeclared here: `extends` inherits the base's exclude, and
     the base excludes the src test files — inheriting that would drop the very test
     files this config exists to bind, sending them back to the inferred project.
     Overriding it (node_modules + dist only) keeps the tests in the project.

     CI still type-checks app code through ../tsconfig.json and tests through
     ../tsconfig.test.json (see package.json); this file is never built. */
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "..",
    "incremental": false
  },
  "include": ["**/*.ts"],
  "exclude": ["../node_modules", "../dist"]
}
