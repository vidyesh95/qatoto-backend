.idea
.vscode
/node_modules
.pnpm-store
/dist
*.tsbuildinfo
.env
/certs
.DS_Store

# Vitest 5 writes every generated artifact here — blob reports, html, json, junit,
# and test attachments. Nothing in `scripts` emits them today, but `--reporter=json`
# during a debugging session would otherwise leave untracked files in the repo root.
.vitest
# `test:coverage` (v8 provider) writes here.
/coverage

/secure

# Terraform (infra/). The provider lock file IS committed; state, plans and real tfvars
# are not — infra/prod state lives in S3, infra/bootstrap state is kept off-repo.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
*.tfvars
!*.tfvars.example
crash.log
