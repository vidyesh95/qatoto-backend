{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise"],
  "env": {
    "node": true,
    "es2024": true
  },
  "ignorePatterns": ["dist", "node_modules", ".agent", ".agents"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "off"
  },
  "options": {
    "typeAware": true,
    "maxWarnings": 10
  },
  "rules": {
    "no-alert": "error",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["__filename", "__dirname"]
      }
    ],
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-plusplus": "off",
    "oxc/approx-constant": "warn",
    "eslint/prefer-const": [
      "error",
      {
        "destructuring": "any"
      }
    ],
    "typescript/no-explicit-any": "error",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/dotenv/config"]
      }
    ],
    "import/no-relative-parent-imports": "error"
  },
  "overrides": [
    {
      "files": [
        "src/index.ts",
        "src/worker.ts",
        "src/jobs-install.ts",
        "src/db/index.ts",
        "src/lib/auth.ts",
        "src/lib/logger.ts",
        "scripts/**/*.ts"
      ],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.spec.ts", "tests/**"],
      "plugins": ["vitest"],
      "env": {
        "vitest": true
      }
    }
  ]
}
