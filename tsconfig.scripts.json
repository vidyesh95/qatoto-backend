{
  /* Type-checks one-off operational scripts in scripts/ (run via tsx, never built
     into dist/). Extends the app config so #src/* subpath imports resolve to the TS
     source via "customConditions": ["development"]. Non-composite, no emit — exists
     purely so `tsc -p tsconfig.scripts.json` (CI typecheck) type-checks these files.
     The editor picks up scripts/ via scripts/tsconfig.json instead. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "incremental": false
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
