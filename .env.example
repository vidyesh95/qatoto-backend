PORT=8000
DATABASE_URL=postgres://user:password@localhost:5432/qatotodb
NODE_ENV=development
# pnpm dlx auth@latest secret
BETTER_AUTH_SECRET=your-secret-here-min-16-chars
FRONTEND_URL=http://localhost:3000
# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# GitHub OAuth — https://github.com/settings/developers
# Authorization callback URL: http://localhost:8000/api/auth/callback/github
# Must include user:email scope (read user email)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Brevo transactional email (OTP delivery) — https://app.brevo.com/settings/keys/api
# Optional in development (OTP is logged to console); required in production.
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@yourdomain.com
BREVO_SENDER_NAME=Qatoto


# --- Notifications (§11l.2) -------------------------------------------------
# Whether the notification worker may actually SEND email. The in-app row is always
# written; this only governs the email copy.
#
# Default: ON in production, OFF everywhere else. Leave it unset locally. Setting it
# to "true" in development sends real mail to whatever addresses your fixtures carry —
# a single smoke run fans out well over a hundred notifications, and the smoke fixtures
# use fabricated domains that bounce.
# NOTIFICATION_EMAIL_ENABLED=true

# Whether /openapi.json, /docs and /redoc are served. Default on; set "false" in
# production, where the spec enumerates every route including the admin subtrees.
# DOCS_ENABLED=false

# Whether bearer() accepts ONLY the signed <token>.<hmac> form. Default false, which is
# today's behaviour. MUST be true before the first native release — after that, flipping
# it logs every mobile user out.
# BEARER_REQUIRE_SIGNATURE=true
# --- Native clients (Kotlin / Swift). All optional: unset means web-only, and every
# --- setting below spreads an empty list, so auth behaves exactly as it does today.
# Extra WebAuthn ceremony origins, comma-separated. NO trailing slash — the origin is
# compared by exact string. Android: the base64url SHA-256 of the RELEASE signing cert.
# PASSKEY_NATIVE_ORIGINS=android:apk-key-hash:Zm9vYmFy,https://app.qatoto.com
# Deep-link schemes for OAuth callbacks, comma-separated. Each MUST end in "://" —
# Better Auth prefix-matches non-http entries, so "qatoto" alone matches nothing.
# NATIVE_DEEP_LINK_SCHEMES=qatoto://
# Livepeer — https://livepeer.studio/dashboard/developers/api-keys
#
# DEFERRED AND UNUSED. Self-hosted video is Appendix A of
# docs/STUDIO_BACKEND_STRUCTURE.md and is NOT built: nothing in the codebase reads these
# three variables, and `pnpm dev` does not need them set. They are kept so the switch to
# self-hosting is a re-read rather than a redesign. The shipped video path stores an
# 11-character YouTube id and touches no video bytes at all.
LIVEPEER_API_KEY=your-livepeer-api-key
# Webhook/asset signing keypair — https://docs.livepeer.org/developers/guides/generate-webhook-signing-key-pair
# base64-encoded PEM
LIVEPEER_SIGNING_KEY_PUBLIC=your-base64-encoded-public-key
LIVEPEER_SIGNING_KEY_PRIVATE=your-base64-encoded-private-key

# --- Studio video (docs/STUDIO_BACKEND_STRUCTURE.md). The creator pastes a YouTube link;
# --- the server verifies it with one free oEmbed call. No API key, no quota, no video
# --- bytes ever touch this server.
# Bounds the oEmbed verify so a hanging request cannot hold an Express worker. Optional.
YOUTUBE_OEMBED_TIMEOUT_MS=3000

# --- Daily-log analysis (docs/R_AND_D_BACKEND_STRUCTURE.md §8). One Gemini call per
# --- submitted daily log returns the transcript, the AI summary chips, the extracted
# --- claims and the evidence links together.
#
# Get a key at https://aistudio.google.com/apikey — the free tier needs no billing
# account. OPTIONAL: with no key set, a submitted log records
# `analysis_status = 'skipped_unconfigured'` and keeps its narrative. Nothing is
# fabricated and no verdict is ever written.
#
# Free-tier limits are per-model and change; check the current ones before raising
# WORKER_CONCURRENCY, because every concurrent analyze-daily-log job is one request.
GEMINI_API_KEY=your-gemini-api-key
# A THINKING model. src/lib/gemini.ts pins `thinkingConfig.thinkingLevel` to "low" for it —
# note that the Gemini 2.5-era `thinkingBudget` spelling is rejected outright (HTTP 400)
# by the 3.x family, so a downgrade to a 2.5 model here is not a drop-in swap.
GEMINI_MODEL=gemini-3.5-flash-lite
# The model watches a video end to end, so this is generous — but bounded, because the
# call holds a worker job slot for its whole duration. A timeout is RETRYABLE, so a tight
# value costs five backoff attempts rather than failing fast.
GEMINI_TIMEOUT_MS=180000
# A CAP, not a reservation: an unused ceiling costs nothing, while an undersized one turns
# a long transcript into `finishReason: MAX_TOKENS` — classified PERMANENT, so the log
# dead-letters as `failed` instead of retrying. The model's own limit is 65536.
GEMINI_MAX_OUTPUT_TOKENS=32768

# --- §9 Proof of Effort integrations (docs/R_AND_D_BACKEND_STRUCTURE.md §9.10).
#
# BOTH BLOCKS ARE OPTIONAL, and their absence is a working configuration rather than a
# degraded one. With neither set, `POST …/integrations/:provider/authorize-url` answers
# 503 INTEGRATION_UNCONFIGURED and artifact grounding falls back to the evidence links §8
# already stores — which resolve `flagged`, so a human reviews the claim. Nothing is ever
# silently verified on evidence nobody fetched.
#
# The key that envelope-encrypts third-party access tokens at rest (AES-256-GCM). Minimum
# 32 characters. NO DEFAULT AND NO FALLBACK: a default key is indistinguishable from
# plaintext to anyone who has read the source, so an unset value disables integrations
# entirely instead. §9.10 specifies a KMS-held key; src/lib/token-encryption.ts isolates
# the derivation into one function so that swap is an edit rather than a migration.
# Generate with: openssl rand -base64 48
# INTEGRATION_TOKEN_SECRET=your-integration-token-secret-min-32-chars
#
# The GitHub App that grounds code artifacts — https://github.com/settings/apps
# Callback URL: http://localhost:8000/integrations/github/callback
# Request the NARROWEST scope that works: a repo-scoped installation, never a user PAT.
# All three are required together.
# GITHUB_APP_ID=your-github-app-id
# GITHUB_APP_CLIENT_ID=your-github-app-client-id
# GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
#
# Bounds an artifact-grounding fetch so a hanging provider cannot hold a worker job slot.
INTEGRATION_HTTP_TIMEOUT_MS=10000
