{
  "compilerOptions": {
    /* Language & environment */
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node"],

    /* Modules — Node ESM with package.json "imports" subpaths (#src/*) */
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "customConditions": ["development"],
    /* REDUNDANT FOR tsc, LOAD-BEARING FOR oxlint. package.json's "imports" map sends
       #src/* to ./src/*.ts under the "development" condition and to ./dist/*.js
       otherwise, and the line above is what makes tsc take the source branch.
       oxlint's resolver does NOT honour customConditions: it took the default branch
       and read dist/, so `pnpm lint` reported phantom "not found in imported
       namespace" errors for every export added since the last `pnpm build` — a lint
       result that depended on build staleness. It DOES honour "paths", so this pins
       both to the source. Nothing else changes: "paths" never rewrites an emitted
       specifier, so the built dist/ still resolves through the "imports" map's
       default branch at runtime. */
    "paths": { "#src/*": ["./src/*"] },
    "resolveJsonModule": true,

    /* Emit — tsc builds src/ -> dist/ */
    "outDir": "./dist",
    "rootDir": "./src",
    "sourceMap": true,
    "incremental": true,

    /* Interop */
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* Type checking */
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  /* `src/test-support/**` is test-only and must not reach dist/. It lives under src/ so
     the suites can import it through the #src/* map like everything else, and it is
     excluded here rather than moved because tsconfig.test.json re-includes it. */
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test-support/**"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
