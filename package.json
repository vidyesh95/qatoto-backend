{
  "name": "qatoto-backend",
  "version": "0.1.0",
  "description": "Qatoto Backend",
  "keywords": [],
  "license": "MIT",
  "author": "Vidyesh Churi",
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#src/*.js": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#src/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx watch --conditions=development src/index.ts",
    "dev:worker": "tsx watch --conditions=development src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "jobs:install": "tsx --conditions=development src/jobs-install.ts",
    "jobs:install:prod": "node dist/jobs-install.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:cleanup-orphans": "tsx --conditions=development scripts/cleanup-orphan-signups.ts",
    "db:seed-research-categories": "tsx --conditions=development scripts/seed-research-categories.ts",
    "db:seed-discovery-lookups": "tsx --conditions=development scripts/seed-discovery-lookups.ts",
    "db:seed-supplier-capabilities": "tsx --conditions=development scripts/seed-supplier-capabilities.ts",
    "db:verify-discovery-constraints": "tsx --conditions=development scripts/verify-discovery-constraints.ts",
    "db:verify-go-to-market-constraints": "tsx --conditions=development scripts/verify-go-to-market-constraints.ts",
    "db:verify-workshop-constraints": "tsx --conditions=development scripts/verify-workshop-constraints.ts",
    "db:verify-proof-of-effort-constraints": "tsx --conditions=development scripts/verify-proof-of-effort-constraints.ts",
    "db:verify-escrow-constraints": "tsx --conditions=development scripts/verify-escrow-constraints.ts",
    "db:verify-compensation-constraints": "tsx --conditions=development scripts/verify-compensation-constraints.ts",
    "db:smoke-discovery": "tsx --conditions=development scripts/smoke-discovery-pipeline.ts",
    "db:smoke-cluster-links": "tsx --conditions=development scripts/smoke-cluster-project-links.ts",
    "db:smoke-vocabulary": "tsx --conditions=development scripts/smoke-discovery-vocabulary.ts",
    "db:smoke-workshop": "tsx --conditions=development scripts/smoke-workshop-pipeline.ts",
    "db:smoke-daily-log-analysis": "tsx --conditions=development scripts/smoke-daily-log-analysis.ts",
    "db:smoke-daily-log-feed": "tsx --conditions=development scripts/smoke-daily-log-feed.ts",
    "db:smoke-proof-of-effort": "tsx --conditions=development scripts/smoke-proof-of-effort.ts",
    "db:smoke-funding": "tsx --conditions=development scripts/smoke-funding.ts",
    "db:smoke-compensation": "tsx --conditions=development scripts/smoke-compensation.ts",
    "db:expire-stale-project-requests": "tsx --conditions=development scripts/expire-stale-project-requests.ts",
    "db:reconcile-project-stats": "tsx --conditions=development scripts/reconcile-project-stats.ts",
    "db:cleanup-handle-reservations": "tsx --conditions=development scripts/cleanup-expired-handle-reservations.ts",
    "db:backfill-handles": "tsx --conditions=development scripts/backfill-handles.ts",
    "db:backfill-oauth-profile": "tsx --conditions=development scripts/backfill-oauth-profile.ts",
    "db:merge-duplicate-user": "tsx --conditions=development scripts/merge-duplicate-user.ts",
    "db:grant-platform-role": "tsx --conditions=development scripts/grant-platform-role.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.25",
    "@node-rs/argon2": "^2.0.2",
    "better-auth": "^1.6.25",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "http-errors": "^2.0.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pg": "^8.22.0",
    "pg-boss": "^12.26.3",
    "redoc-express": "^2.1.3",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^0.23.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
