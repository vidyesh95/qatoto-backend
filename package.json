{
  "name": "qatoto-backend",
  "version": "0.1.0",
  "description": "Qatoto Backend",
  "keywords": [],
  "license": "MIT",
  "author": "Vidyesh Churi",
  "type": "module",
  "main": "dist/index.js",
  "imports": {
    "#src/*.js": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    },
    "#src/*": {
      "development": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev": "tsx watch --conditions=development src/index.ts",
    "dev:worker": "tsx watch --conditions=development src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "jobs:install": "tsx --conditions=development src/jobs-install.ts",
    "jobs:inspect-failures": "tsx --conditions=development scripts/inspect-job-failures.ts",
    "jobs:trigger": "tsx --conditions=development scripts/trigger-job.ts",
    "jobs:install:prod": "node dist/jobs-install.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:cleanup-orphans": "tsx --conditions=development scripts/cleanup-orphan-signups.ts",
    "db:seed-research-categories": "tsx --conditions=development scripts/seed-research-categories.ts",
    "db:seed-discovery-lookups": "tsx --conditions=development scripts/seed-discovery-lookups.ts",
    "db:seed-supplier-capabilities": "tsx --conditions=development scripts/seed-supplier-capabilities.ts",
